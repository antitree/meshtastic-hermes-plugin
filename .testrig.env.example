# Live test rig configuration — PLACEHOLDERS ONLY.
#
# Copy this file to `.testrig.env` and fill it in. `.testrig.env` is gitignored
# and must stay that way: it is the only place host-specific details live, which
# is what keeps them out of commits, PRs and issues.
#
#     cp .testrig.env.example .testrig.env
#     $EDITOR .testrig.env
#     ./scripts/testrig.sh
#
# See docs/testing.md for what each check covers and the safety rules.

# --- Required ---------------------------------------------------------------

# Host running Hermes and the Meshtastic gateway. Must be reachable by
# passwordless (key-based) SSH from the machine running the rig.
TESTRIG_HOST=your-host.example.com

# SSH user. Leave blank to use whatever your ~/.ssh/config sets for the host.
TESTRIG_USER=your-user

# Hermes profile whose gateway owns the radio (used as `hermes -p <profile>`).
TESTRIG_PROFILE=your-profile

# --- Optional (sensible defaults derived from TESTRIG_PROFILE) --------------

# Dedicated channel for the opt-in transmit check. NEVER point this at a real
# channel you use. Only consulted when --transmit is passed.
TESTRIG_TEST_CHANNEL=your-test-channel

# Throwaway directory on the remote host. The rig syncs the working tree here
# and DELETES it afterwards, so it must never point inside ~/.hermes/profiles,
# ~/.hermes/plugins or ~/.hermes/hermes-agent — the rig refuses those.
TESTRIG_REMOTE_DIR=~/.cache/meshtastic-testrig

# The profile's Hermes home. Default: ~/.hermes/profiles/<TESTRIG_PROFILE>
#TESTRIG_HERMES_HOME=~/.hermes/profiles/your-profile

# Gateway log the rig reads for live receive/channel evidence.
# Default: <TESTRIG_HERMES_HOME>/logs/gateway.log
#TESTRIG_GATEWAY_LOG=~/.hermes/profiles/your-profile/logs/gateway.log

# Python interpreter of the real Hermes install — this is what makes the REAL
# BasePlatformAdapter importable. Default: ~/.hermes/hermes-agent/venv/bin/python
#TESTRIG_HERMES_PYTHON=~/.hermes/hermes-agent/venv/bin/python

# Gateway service name. Recorded for diagnostics only: the rig NEVER starts,
# stops, restarts or reconfigures the service.
TESTRIG_SERVICE=
